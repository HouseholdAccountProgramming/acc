{
    // 기존 설정 (그대로 유지)
    "workbench.settings.useSplitJSON": false,
    
    // 1. 모든 파일을 UTF-8로 저장하도록 설정 (가장 기본적인 인코딩 통일)
    "files.encoding": "utf8",
    
    // 2. Windows 터미널에서 한글 출력을 위해 코드 페이지를 UTF-8(65001)로 강제 설정
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            // PowerShell 시작 시 chcp 65001 명령을 실행하도록 설정
            "args": ["-NoExit", "/c", "chcp 65001 >$null ; cls"],
            "icon": "terminal-powershell"
        }
    },
    "java.project.sourcePaths": [
        "acc/target/classes/com/accountbook",
        "acc/src/main/java",
        "acc"
    ]
}